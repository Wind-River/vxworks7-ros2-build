# VxWorks Rust alignment for ROS 2 (rclrs + examples). Generated by pkg/sdk (sdk_rust_fixups)
# into $WS/src/.cargo/config.toml. cargo (>=1.84) honors [patch] in config.toml and
# walks up from each package dir, so this applies to every rust package in the
# workspace without editing each manifest.

# libloading lacks VxWorks support for the RTLD_* dlopen flags; pkg/sdk (sdk_rust_fixups)
# builds a patched libloading under ROS2_RUST_CRATES_DIR (the SDK vxworks-crates dir).
# Replace the crates.io version with that patched copy.
[patch.crates-io]
libloading = { path = "${ROS2_RUST_CRATES_DIR}/libloading" }

# ROS 2 C libraries (librcutils, rcl_yaml_param_parser, rmw_implementation, ...)
# call dlopen()/dlerror() and reference each other transitively. The rclrs node
# binary link (driven by cargo) must find them in the install lib dir and resolve
# transitive shared-lib symbols.
#
# The rclrs node link must resolve, transitively, the libs that librcl.so /
# librmw_implementation.so / librcutils.so NEED. Those split into two sets:
#   1. ROS 2 install libs       -> ${ROOT_DIR}/lib
#   2. VxWorks base + 3pp libs  -> the SDK sysroot (libc.so.1, libcplusplus.so.1,
#      libllvmcplus.so.1, libunix.so.1, libnet.so.1, libyaml.so, ...)
#
# IMPORTANT: the base/3pp libs are NEVER installed into ${ROOT_DIR}/lib. They live
# in the SDK sysroot at build time; defs.sdk.mk copies them from
# $WIND_CC_SYSROOT/usr/lib/common and /usr/3pp/develop/usr/lib into DEPLOY_DIR/lib,
# and the image (target /usr/lib) is built from DEPLOY_DIR. The C/C++ node links
# find them automatically via the CMake toolchain's --sysroot default search; a Rust
# link uses -nodefaultlibs so that default search is disabled for TRANSITIVE
# resolution. We therefore add the exact sysroot dirs `wr-c++ -print-search-dirs`
# lists as -rpath-link so the transitive chain resolves at link time. (-rpath-link
# is a link-time-only search; it is never recorded in the binary, so the runtime
# loader still uses the target's /usr/lib.)
#
# Without these, the linker cannot load librmw_implementation.so's own deps, silently
# drops it (with the old --allow-shlib-undefined), and the rmw C API symbols
# (rmw_get_implementation_identifier, ...) resolve to NULL -> SIGSEGV PC=0x0 at the
# first rmw call. --no-as-needed keeps librmw_implementation.so in DT_NEEDED. We do
# NOT use --allow-shlib-undefined (that was the original bug: it hid this at link
# time and deferred it to a NULL call at runtime).
[target.'cfg(target_os = "vxworks")']
# ROS 2-SPECIFIC only: resolve the ROS 2 install-tree libs ($(ROOT_DIR)/lib). The
# GENERIC VxWorks RTP-link flags (crt-static off, -ldl, --export-dynamic, --sysroot,
# --no-as-needed, --allow-shlib-undefined) come from the SDK cargo config's
# cfg(target_os="vxworks") block; cargo MERGES same-cfg blocks across config files.
# -rpath-link is link-time only; runtime uses the target /usr/lib.
rustflags = [
    "-C", "link-arg=-L${ROOT_DIR}/lib",
    "-C", "link-arg=-Wl,-rpath-link,${ROOT_DIR}/lib",
]
