Subject: [PATCH] tmp: meta-patch gen

---
 .../0001-sqlite3-vxworks-use-unix-vfs.patch   | 20 ++++++++
 patches/0002-libtool-vxworks-shared.patch     | 50 +++++++++++++++++++
 2 files changed, 70 insertions(+)
 create mode 100644 patches/0001-sqlite3-vxworks-use-unix-vfs.patch
 create mode 100644 patches/0002-libtool-vxworks-shared.patch

diff --git a/patches/0001-sqlite3-vxworks-use-unix-vfs.patch b/patches/0001-sqlite3-vxworks-use-unix-vfs.patch
new file mode 100644
index 0000000..ef4b4ff
--- /dev/null
+++ b/patches/0001-sqlite3-vxworks-use-unix-vfs.patch
@@ -0,0 +1,20 @@
+VxWorks: select the Unix VFS for the SQLite amalgamation.
+
+sqlite3.c's VxWorks block (guarded by __RTP__ / _WRS_KERNEL, which wr-cc defines)
+sets `#define SQLITE_OS_OTHER 0`. With SQLITE_OS_OTHER *defined* (even to 0), the OS
+auto-select at the bottom of the amalgamation skips the default `SQLITE_OS_UNIX 1`
+branch and `#if SQLITE_OS_OTHER+1>1` is false — leaving NO VFS selected on VxWorks.
+Commenting it out leaves SQLITE_OS_OTHER undefined so the Unix VFS is chosen, which
+is correct: VxWorks is POSIX-like. (Equivalent to the Wind River contrib
+sqlite-3.50.4/usr_src/0004 patch, re-based onto the 3.46.1 amalgamation.)
+--- a/sqlite3.c
++++ b/sqlite3.c
+@@ -160,7 +160,7 @@
+ #include <vxWorks.h>
+ #include <pthread.h>  /* amalgamator: dontcache */
+ #define OS_VXWORKS 1
+-#define SQLITE_OS_OTHER 0
++/* #define SQLITE_OS_OTHER 0 */ /* VxWorks: leave undefined so SQLITE_OS_UNIX is selected (POSIX-like) */
+ #define SQLITE_HOMEGROWN_RECURSIVE_MUTEX 1
+ #define SQLITE_OMIT_LOAD_EXTENSION 1
+ #define SQLITE_ENABLE_LOCKING_STYLE 0
diff --git a/patches/0002-libtool-vxworks-shared.patch b/patches/0002-libtool-vxworks-shared.patch
new file mode 100644
index 0000000..20028c0
--- /dev/null
+++ b/patches/0002-libtool-vxworks-shared.patch
@@ -0,0 +1,50 @@
+Enable a shared libsqlite3 for the vxworks host.
+
+The bundled libtool (in configure) has no vxworks branch in three
+case $host_os tables, which together force a static-only build:
+  1. dynamic_linker       -> default dynamic_linker=no -> can_build_shared=no
+  2. GNU-ld archive_cmds  -> empty for vxworks -> link falls back to a static .a
+  3. deplibs_check_method -> 'unknown' -> with -no-undefined and a dependent
+                             library (e.g. -lz) libtool downgrades to static
+vxworks is ELF and uses GNU ld, so it behaves like linux: fold vxworks into the
+linux groups and give dynamic_linker a linux-style ELF naming arm. Result: a
+proper versioned shared object (libsqlite3.so.N) with soname, matching how the
+platform ships SQLite elsewhere.
+
+--- a/configure
++++ b/configure
+@@ -6951,7 +6951,7 @@
+   ;;
+ 
+ # This must be glibc/ELF.
+-linux* | k*bsd*-gnu | kopensolaris*-gnu | gnu*)
++linux* | k*bsd*-gnu | kopensolaris*-gnu | gnu* | vxworks*)
+   lt_cv_deplibs_check_method=pass_all
+   ;;
+ 
+@@ -10714,7 +10714,7 @@
+       archive_expsym_cmds='sed "s|^|_|" $export_symbols >$output_objdir/$soname.expsym~$CC -shared $pic_flag $libobjs $deplibs $compiler_flags $wl-h,$soname $wl--retain-symbols-file,$output_objdir/$soname.expsym $wl--image-base,`expr ${RANDOM-$$} % 4096 / 2 \* 262144 + 1342177280` -o $lib'
+       ;;
+ 
+-    gnu* | linux* | tpf* | k*bsd*-gnu | kopensolaris*-gnu)
++    gnu* | linux* | tpf* | k*bsd*-gnu | kopensolaris*-gnu | vxworks*)
+       tmp_diet=no
+       if test linux-dietlibc = "$host_os"; then
+ 	case $cc_basename in
+@@ -12817,6 +12817,16 @@
+   shlibpath_var=LD_LIBRARY_PATH
+   ;;
+ 
++vxworks*)
++  version_type=linux
++  need_lib_prefix=no
++  need_version=no
++  library_names_spec='$libname$release$shared_ext$versuffix $libname$release$shared_ext$major $libname$shared_ext'
++  soname_spec='$libname$release$shared_ext$major'
++  shlibpath_var=LD_LIBRARY_PATH
++  shlibpath_overrides_runpath=no
++  hardcode_into_libs=yes
++  ;;
+ *)
+   dynamic_linker=no
+   ;;
