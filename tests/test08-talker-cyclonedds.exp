proc test08-talker-cyclonedds {} {
    puts "\nTEST: PUB/SUB (rmw_cyclonedds_cpp, loopback via CYCLONEDDS_URI)"

    # Same talker/listener as test04 but using the CycloneDDS RMW. CycloneDDS
    # does not use FASTDDS_BUILTIN_TRANSPORTS; on VxWorks two RTPs only discover
    # each other once bound to the loopback interface, so point CYCLONEDDS_URI at
    # the shipped /usr/cyclonedds.xml (127.0.0.1). Without it the talker
    # publishes but the listener stays silent. Env is per-RTP, so set RMW +
    # CYCLONEDDS_URI on BOTH the serial console (talker) and the telnet console
    # (listener).
    vxworks::set_env $qemu::spawn_id "RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
    vxworks::set_env $qemu::spawn_id "CYCLONEDDS_URI=/usr/cyclonedds.xml"

    send "/usr/lib/demo_nodes_cpp/talker\r"
    expect -exact {Publishing}
    expect -exact {Publishing}
    expect -exact {Publishing}
    expect -exact {Publishing}
    expect -exact {Publishing}

    # Subscriber over telnet (second console) while the talker runs on serial.
    set tid [telnet::open]
    if {$tid ne ""} {
        vxworks::set_env $tid "RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
        vxworks::set_env $tid "CYCLONEDDS_URI=/usr/cyclonedds.xml"
        vxworks::run_node $tid "/usr/lib/demo_nodes_cpp/listener" "I heard"
        telnet::close $tid
    }

    send_ctrl_c
}
