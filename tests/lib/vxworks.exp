# vxworks.exp - Expect/Tcl library for VxWorks target shell semantics
#
# Console-agnostic: these procs operate on an explicit spawn id, so they work
# over either the QEMU serial console (lib/qemu.exp) or a telnet console
# (lib/telnet.exp). Nothing here spawns or transports; it only knows how the
# VxWorks shells behave.
#
# --- The two VxWorks shells (single source of truth) -----------------------
#
# The target ALWAYS boots into the kernel shell; the command shell is reached
# from it by typing 'cmd'. The two shells, in boot order:
#
#   1. kernel shell   prompt: "->"          (boot default; the C-interpreter
#                                            shell. Run kernel routines here,
#                                            e.g. 'edrShow', 'taskShow'.)
#   2. command shell  prompt: "[vxWorks *]#" (entered by typing 'cmd' at '->';
#                                            POSIX-like shell that runs RTPs,
#                                            'set env', 'rtp exec', etc.)
#
# So every console starts at '->' and must 'cmd' into the command shell before
# running tests.
#
# Direction of travel between the two shells:
#   kernel -> command : type 'cmd'             (see enter_cmd_shell)
#   command -> kernel : prefix a kernel routine with 'C ', which runs it in the
#                       kernel interpreter WITHOUT leaving the command shell,
#                       e.g.  C edrShow  /  C taskShow  (see kernel_cmd).
#
# All prompt matching goes through these two variables, so a prompt change is
# edited in exactly one place. prompt_cmd matches the command-shell prompt TAIL
# "]# " (the full prompt is "[vxWorks *]# "); matching the tail -- not the
# "[vxWorks" prefix -- guarantees the shell has finished drawing the prompt and
# is ready for input, so the first character of the next command is not swallowed.
# prompt_kernel is a RE.

namespace eval vxworks {
    variable prompt_kernel {->}
    variable prompt_cmd    {]# }

    # Drain any pending output on a channel until it is quiet for `quiet` seconds.
    # The VxWorks serial console drops the leading characters of a command that is
    # typed while the shell is still emitting the previous command's output (a
    # prompt can be drawn mid-scroll). Draining to a quiet window before sending
    # guarantees the console is idle and ready, so no characters are swallowed
    # (observed: "/usr/lib/.../timer_lambda" arriving as "r/lib/.../timer_lambda").
    proc drain {id {quiet 1}} {
        expect -i $id -timeout $quiet {
            -re {.+} { exp_continue }
            timeout {}
        }
    }

    # Send a command on a channel the safe way: drain to a quiet console first,
    # then send. Use this instead of a bare `send` for anything typed at a shell
    # prompt. Does NOT wait for a result -- the caller expects its own marker.
    proc send_cmd {id cmd} {
        drain $id
        send -i $id "$cmd\r"
    }

    # Enter the command shell from the kernel shell on the given channel.
    proc enter_cmd_shell {id} {
        variable prompt_cmd
        send_cmd $id "cmd"
        expect -i $id -exact $prompt_cmd
    }

    # Run a kernel-shell routine from WITHIN the command shell via the 'C'
    # prefix (e.g. kernel_cmd $id "edrShow"), then wait for the command-shell
    # prompt to return. No shell switch: this stays in the command shell.
    proc kernel_cmd {id routine} {
        variable prompt_cmd
        send_cmd $id "C $routine"
        expect -i $id -exact $prompt_cmd
    }

    # Set an environment variable in the command shell on the given channel
    # (e.g. set_env $id "RMW_IMPLEMENTATION=rmw_fastrtps_cpp"), then wait for the
    # prompt. Env is per-RTP, so set it on each channel before launching a node.
    proc set_env {id assignment} {
        variable prompt_cmd
        send_cmd $id "set env \"$assignment\""
        expect -i $id -exact $prompt_cmd
    }

    # Run a node/RTP on the given channel and expect its completion marker
    # 'count' times (default 5). Raises a Tcl error (the test fails) on a
    # timeout, a closed console, or the node aborting/crashing (signal 6/11)
    # before the marker was seen 'count' times.
    proc run_node {id cmd marker {count 5}} {
        send_cmd $id "$cmd"
        run_node_wait $id $marker $count
    }

    # Wait for a running node's marker 'count' more times, with the same failure
    # rules as run_node (timeout, closed console, abort/crash). Use it to check a
    # second marker of a node run_node already started.
    proc run_node_wait {id marker {count 5}} {
        for {set i 0} {$i < $count} {incr i} {
            expect -i $id \
                -exact $marker {} \
                -re {terminating due to uncaught exception[^\r\n]*} {
                    error "node aborted: $expect_out(0,string)"
                } \
                -re {has been deleted due to signal (6|11)} {
                    error "node crashed: $expect_out(0,string)"
                } \
                timeout {
                    error "timed out waiting for '$marker' ($i of $count seen)"
                } \
                eof {
                    error "console closed waiting for '$marker' ($i of $count seen)"
                }
        }
    }

    # Ensure the target wall clock is set. QEMU has no RTC, so VxWorks boots with
    # an unset clock (epoch -> "... 1970"). A 1970 clock breaks time-sensitive
    # features -- notably SROS2/Fast-DDS X.509 validation, which rejects the CA
    # cert as "certificate is not yet valid" because its notBefore is far in the
    # future relative to 1970. Read 'date'; only if it reports 1970 (i.e. unset)
    # set the target date + time from the host via the command-shell setters
    #   date "YYYY-MM-DD"   /   time "HH:MM:SS"
    # If the clock already has a real year (e.g. an RTC-backed board), leave it.
    proc set_clock {id} {
        variable prompt_cmd
        send_cmd $id "date"
        expect -i $id -exact $prompt_cmd
        if {[string match "*1970*" $expect_out(buffer)]} {
            set now [clock seconds]
            set d [clock format $now -format "%Y-%m-%d"]
            set t [clock format $now -format "%H:%M:%S"]
            puts "target clock unset (1970); setting from host: $d $t"
            send_cmd $id "date \"$d\""
            expect -i $id -exact $prompt_cmd
            send_cmd $id "time \"$t\""
            expect -i $id -exact $prompt_cmd
        } else {
            puts "target clock already set; leaving it"
        }
    }
}
