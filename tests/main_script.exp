#!/usr/bin/expect

# Runs on-target test suites on VxWorks under QEMU.
#
# One directory per suite, its tests numbered from 01 (test<NN>-<name>.exp):
#   ros2/       ROS 2 nodes from the image                  (default suite)
#   toolkit/    nodes the SDK toolkit built (selftest-build.sh), on USB /bd0a
#   unixextra/  the unixextra C function tests (pkg/unixextra), on USB /bd0a
#
# Three Expect/Tcl libraries under lib/:
#   vxworks.exp (::vxworks) - target shell semantics: prompts, 'cmd',
#                             'C <routine>', run_node (console-agnostic)
#   qemu.exp    (::qemu)    - QEMU serial console transport: boot, Ctrl-C, quit
#   telnet.exp  (::telnet)  - telnet console transport: second shell
# vxworks.exp is sourced first because qemu/telnet reference ::vxworks.
# This script only orchestrates: boot, run the selected suites/tests, quit.

set test_directory [file dirname [info script]]
source [file join $test_directory lib vxworks.exp]
source [file join $test_directory lib qemu.exp]
source [file join $test_directory lib telnet.exp]

# Function to run all tests. Each test proc either returns normally (PASS),
# raises an error (FAIL: test_fail, vxworks::run_node, or any Tcl error), or
# calls test_skip (SKIP). The results are collected in ::test_results and
# summarised (and turned into the exit status) by report_tests.
set test_results {}
proc run_tests {test_scripts} {
    foreach test_script $test_scripts {
        set suite [file tail [file dirname $test_script]]
        # the test procs this script defines, run in name order; removed again
        # afterwards, so suites may reuse the same test names
        set before [info procs test*]
        source $test_script
        set procs {}
        foreach p [lsort [info procs test*]] {
            if {[lsearch -exact $before $p] < 0 && ![string match "test_*" $p]} { lappend procs $p }
        }
        foreach test_function $procs {
            set name $suite/$test_function
            set code [catch {$test_function} err opts]
            if {$code == 0 || $code == 2} {
                puts "\nPASS $name"
                lappend ::test_results PASS $name
            } elseif {[dict get $opts -errorcode] eq {TEST SKIP}} {
                puts "\nSKIP $name: $err"
                lappend ::test_results SKIP $name
            } else {
                puts "\nFAIL $name: $err"
                lappend ::test_results FAIL $name
                # The test did not reach its own cleanup: stop whatever it left
                # running in the foreground of the serial console.
                qemu::send_ctrl_c
            }
            # Close the telnet sessions a failed test left open (with its node
            # still running there), so the next test starts with none.
            telnet::close_all
            # Back to the serial console: a test may have left the telnet spawn
            # as the implicit channel.
            set spawn_id $qemu::spawn_id
            # Settle the console on a fresh command-shell prompt before the next
            # test runs. Draining to a quiet window is handled by the library
            # (vxworks::drain) so the settle logic lives in exactly one place.
            vxworks::drain $qemu::spawn_id
            send "\r"
            expect -exact $vxworks::prompt_cmd
            # Give the next test the environment the target booted with: tests
            # set RMW, transport and security variables on the serial console.
            vxworks::env_restore $qemu::spawn_id $::boot_env
            rename $test_function ""
        }
    }
}

# Print the per-test results and return the exit status: 1 if any test failed.
proc report_tests {} {
    set failed 0
    puts "\nTest results:"
    foreach {result name} $::test_results {
        puts "  $result $name"
        if {$result eq "FAIL"} { incr failed }
    }
    puts "[expr {[llength $::test_results] / 2}] run, $failed failed"
    return [expr {$failed > 0}]
}

# Fail / skip the calling test with a reason (see run_tests). Both raise a Tcl
# error so they also leave the test from inside an expect action; a skip is
# told apart by its errorCode.
proc test_fail {reason} { error $reason }
proc test_skip {reason} { error $reason {} {TEST SKIP} }

# Back-compat shims so existing test*.exp keep working unchanged.
proc send_ctrl_c {} { qemu::send_ctrl_c }
proc quit_qemu {}   { qemu::quit }

# Print a test's banner, numbered from the calling test proc's name (test03-* ->
# "TEST 03: ..."), so the number has one source: the test's file/proc name.
proc test_header {title} {
    set caller [lindex [info level -1] 0]
    if {[regexp {^test(\d+)} $caller -> num]} {
        puts "\nTEST $num: $title"
    } else {
        puts "\nTEST: $title"
    }
}

# Suites whose tests run binaries from a USB dir attached as /bd0a (VX_USB).
set usb_suites {toolkit unixextra}

# Function to display usage information
proc show_usage {} {
    puts "Usage:"
    puts "  main_script \[<ros2.img>\] \[<suite>|<suite>/<test> ...\]"
    puts "  ros2.img - image path (default ./ros2.img)"
    puts "  suite    - a directory under tests/: ros2 (default), toolkit, unixextra;"
    puts "             toolkit and unixextra need VX_USB=<dir> (attached as /bd0a)"
    puts "  test     - one test of a suite, with or without the .exp suffix, e.g."
    puts "               main_script ros2.img ros2"
    puts "               main_script ros2.img ros2/test04-talker ros2/test05-rclrs"
    puts "               VX_USB=<dir> main_script ros2.img unixextra"
    exit 0
}

foreach arg $argv {
    if {$arg == "-h" || $arg == "--help"} {
        show_usage
    }
}

# Parse args: a suite (a directory under tests/) or <suite>/<test> selects tests;
# anything else is the image path (default ./ros2.img).
set img_path "./ros2.img"
set selectors {}
foreach arg $argv {
    set suite [lindex [split $arg /] 0]
    if {[regexp {^[a-z0-9_]+(/test[^/]*)?$} $arg] && [file isdirectory [file join $test_directory $suite]]} {
        lappend selectors $arg
    } else {
        set img_path $arg
    }
}
if {[llength $selectors] == 0} {
    set selectors {ros2}
}

# The test scripts to source, in order: a suite's test*.exp sorted, or the named test.
set test_scripts {}
foreach sel $selectors {
    set suite [lindex [split $sel /] 0]
    if {$sel eq $suite} {
        set found [lsort [glob -nocomplain -directory [file join $test_directory $suite] test*.exp]]
        if {[llength $found] == 0} {
            puts "ERROR: suite $suite has no tests (tests/$suite/test*.exp)"
            exit 1
        }
        lappend test_scripts {*}$found
    } else {
        set path [file join $test_directory [string map {.exp ""} $sel].exp]
        if {![file exists $path]} {
            puts "ERROR: no such test: $sel (tests/[string map {.exp ""} $sel].exp)"
            exit 1
        }
        lappend test_scripts $path
    }
    # USB suites run binaries staged on a host dir attached as /bd0a: without
    # VX_USB there is nothing to run, so refuse instead of booting into a missing /bd0a
    if {[lsearch -exact $usb_suites $suite] >= 0 &&
        (![info exists ::env(VX_USB)] || $::env(VX_USB) eq "" || ![file isdirectory $::env(VX_USB)])} {
        puts "ERROR: suite $suite needs VX_USB=<dir> (its binaries, attached as /bd0a)"
        exit 1
    }
}
puts "\nExecuting: $test_scripts"

# Set timeout for Expect commands (in seconds). raspi4 is fully emulated (TCG,
# no KVM on an x86 host) so boot + node start-up are much slower than the
# KVM-accelerated x86 target; give it a far larger budget. Overridable with
# VX_TIMEOUT.
if {[info exists ::env(VX_TIMEOUT)] && $::env(VX_TIMEOUT) ne ""} {
    set timeout $::env(VX_TIMEOUT)
} elseif {[qemu::target] eq "rpi4"} {
    set timeout 300
} else {
    set timeout 60
}
puts "Target: [qemu::target]  (expect timeout ${timeout}s)"

# Boot QEMU + VxWorks and drop to the command shell.
qemu::boot $img_path

# Make the serial console the default channel for bare send/expect (tests that
# don't pass an explicit -i, e.g. ros2/test01/02/03/05 and run_tests).
set spawn_id $qemu::spawn_id

# The environment the target booted with (vxscript); restored after each test.
set boot_env [vxworks::env_get $qemu::spawn_id]

# Run the tests, then quit QEMU.
run_tests $test_scripts
puts "\nAll tests Done, quitting QEMU"
qemu::quit

# Wait for QEMU to finish
wait

# Exit Expect script: non-zero if any test failed (see report_tests)
exit [report_tests]
