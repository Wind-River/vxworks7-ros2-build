#!/usr/bin/expect

# Runs ROS 2 tests on VxWorks under QEMU.
#
# Three Expect/Tcl libraries under lib/:
#   vxworks.exp (::vxworks) - target shell semantics: prompts, 'cmd',
#                             'C <routine>', run_node (console-agnostic)
#   qemu.exp    (::qemu)    - QEMU serial console transport: boot, Ctrl-C, quit
#   telnet.exp  (::telnet)  - telnet console transport: second shell
# vxworks.exp is sourced first because qemu/telnet reference ::vxworks.
# This script only orchestrates: boot, run every test*.exp, quit.

set test_directory [file dirname [info script]]
source [file join $test_directory lib vxworks.exp]
source [file join $test_directory lib qemu.exp]
source [file join $test_directory lib telnet.exp]

# Function to run all tests
proc run_tests {test_scripts} {
    foreach test_script $test_scripts {
        source $test_script
    }
    set all_procs [info procs]
    set test_procs [lsort [lsearch -all -inline $all_procs test*]]
    foreach test_function $test_procs {
        if {[string match "test*" $test_function]} {
            $test_function
            # Back to the serial console: a test may have left the telnet spawn
            # as the implicit channel.
            set spawn_id $qemu::spawn_id
            send "\r"
            expect -exact $vxworks::prompt_cmd
        }
    }
}

# Back-compat shims so existing test*.exp keep working unchanged.
proc send_ctrl_c {} { qemu::send_ctrl_c }
proc quit_qemu {}   { qemu::quit }

# Function to display usage information
proc show_usage {} {
    puts "Usage:"
    puts "  main_script \[<ros2.img>\] \[test ...\]"
    puts "  ros2.img  - image path (default ./ros2.img)"
    puts "  test ...  - one or more test names to run (default: all)."
    puts "              name with or without the .exp suffix, e.g."
    puts "                main_script ros2.img test06-rclrs"
    puts "                main_script ros2.img test04-talker test06-rclrs"
    exit 0
}

foreach arg $argv {
    if {$arg == "-h" || $arg == "--help"} {
        show_usage
    }
}

# Default path to ros2.img
set default_img_path "./ros2.img"

# Parse args: first non-test arg is the image path; the rest are test selectors.
# A "test selector" is anything that starts with "test"; anything else is the
# image. This lets both of these work:
#   main_script ros2.img                     (image only, run all)
#   main_script ros2.img test06-rclrs         (image + one test)
#   main_script test06-rclrs                  (no image -> default, one test)
set img_path $default_img_path
set selectors {}
foreach arg $argv {
    if {[string match "test*" $arg]} {
        lappend selectors $arg
    } else {
        set img_path $arg
    }
}

# Build the list of test scripts to source. With no selectors, glob them all;
# otherwise take exactly the named ones (accepting an optional .exp suffix).
if {[llength $selectors] == 0} {
    set test_scripts [lsort [glob -nocomplain -directory $test_directory test*.exp]]
} else {
    set test_scripts {}
    foreach name $selectors {
        set file [string map {.exp ""} $name].exp
        set path [file join $test_directory $file]
        if {![file exists $path]} {
            puts "ERROR: no such test: $file (in $test_directory)"
            exit 1
        }
        lappend test_scripts $path
    }
}
puts "\nExecuting: $test_scripts"

# Set timeout for Expect commands (in seconds)
set timeout 60

# Boot QEMU + VxWorks and drop to the command shell.
qemu::boot $img_path

# Make the serial console the default channel for bare send/expect (tests that
# don't pass an explicit -i, e.g. test01/02/03/05 and run_tests).
set spawn_id $qemu::spawn_id

# Run the tests, then quit QEMU.
run_tests $test_scripts
puts "\nAll tests Done, quitting QEMU"
qemu::quit

# Wait for QEMU to finish
wait

# Exit Expect script
exit
